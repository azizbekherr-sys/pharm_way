# Pharm Way — muhit o'zgaruvchilari.
# Serverda: `cp .env.example .env` va qiymatlarni to'ldiring.
# Vercel'dagi qiymatlarni olish: Vercel → Project → Settings → Environment Variables
# (yoki `npx vercel env pull .env --environment=production`).
#
# Diqqat: NEXT_PUBLIC_* qiymatlari build paytida saytga yoziladi —
# ularni o'zgartirgandan keyin qayta deploy qiling (./deploy/deploy.sh).

# --- Supabase (majburiy) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Prisma (faqat `prisma` CLI uchun; ilova Supabase orqali ishlaydi) ---
DATABASE_URL=
DIRECT_URL=

# --- Admin paneldagi AI funksiyalari (tarjima, avto-to'ldirish, rasm) ---
ANTHROPIC_API_KEY=
UNSPLASH_ACCESS_KEY=

# --- Kontakt formasi -> Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Muhit: production'dan boshqa qiymat (masalan staging) robots.txt'da
#     indekslashni yopadi. Asosiy serverda bo'sh qoldiring yoki `production`.
SITE_ENV=production

# --- Ixtiyoriy: SEO tasdiqlash va analitika (SEO-SETUP.md ga qarang) ---
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_YANDEX_METRICA_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
